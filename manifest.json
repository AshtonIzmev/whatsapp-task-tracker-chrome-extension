{
  "manifest_version": 3,
  "name": "WhatsApp Task Tracker",
  "version": "1.0.1",
  "description": "Turn recent WhatsApp messages into a simple, private task list.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "WhatsApp Task Tracker",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://web.whatsapp.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }]
}
